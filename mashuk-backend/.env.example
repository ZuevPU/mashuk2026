PORT=8080
DATABASE_URL=postgresql://user:password@localhost:5432/mashuk?sslmode=disable

# Production: set SKIP_VK_SIGN=false and provide real VK_APP_SECRET
VK_APP_SECRET=your_vk_app_secret_here
SKIP_VK_SIGN=true

# Production: restrict to your frontend/admin origins
CORS_ORIGIN=*

# Production: change from dev-admin-secret (startup fails if NODE_ENV=production)
ADMIN_SECRET=dev-admin-secret

# Required for real VK push notifications (community service token)
VK_SERVICE_TOKEN=

# Fallback: community messages (messages.send)
VK_GROUP_ID=
VK_COMMUNITY_TOKEN=

# VK Callback API (participant event QR → bot → attendance)
# Point Callback URL to POST /api/bot/vk
VK_CALLBACK_CONFIRMATION=
VK_CALLBACK_SECRET=

# Public base URL for uploaded photos / QR (required in production) — NOT the push link
PUBLIC_URL=http://localhost:8080

# Link appended to community DM fallback pushes (VK mini app)
VK_MINI_APP_URL=https://vk.ru/app54662212

