# Production env template — copy to server, do NOT commit filled values
PORT=8080
NODE_ENV=production

DATABASE_URL=postgresql://gen_user:PASSWORD@85.198.80.180:5432/default_db

SKIP_VK_SIGN=false
VK_APP_SECRET=
VK_SERVICE_TOKEN=
# users.get + зеркало аватаров участников (uploads/) — нужен для sync-avatars и админки
VK_GROUP_ID=
VK_COMMUNITY_TOKEN=

ADMIN_SECRET=change-me-not-dev-admin-secret
CORS_ORIGIN=https://zuevpu-mashuk2026-dc9b.twc1.net,https://zuevpu-mashuk2026-9a9a.twc1.net
PUBLIC_URL=https://zuevpu-mashuk2026-ae82.twc1.net
# Ссылка в ЛС сообщества (fallback push) — мини-приложение VK, не backend
VK_MINI_APP_URL=https://vk.ru/app54662212

# Optional: auto-rotate to next draft shift after calendar end
# SHIFT_AUTO_ROTATE=true
# Базовый URL для /uploads (аватары и фото заданий); на Timeweb: volume mashuk_uploads → /app/uploads (см. docker-compose.prod.yml)
# После миграции 0035 и деплоя: npm run sync-avatars (в контейнере backend) для участников без avatar_url

# Set to true once on first deploy to populate empty DB (directions, tasks, demo data)
AUTO_SEED=true

# Analytics stage 2 (semantic dashboards + nightly club matching, heuristics only)
# См. docs/V2_FEATURES.md
# SEMANTIC_ANALYTICS_V2=true
# ANALYTICS_REFRESH_MINUTES=15

# VK Callback API for event QR → bot attendance (POST /api/bot/vk)
# VK_CALLBACK_CONFIRMATION=
# VK_CALLBACK_SECRET=

# Единый рейтинг (forum_points); false — dual Path+Experience в UI
UNIFIED_RATING=true
